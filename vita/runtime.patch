+    char buf[16384];
+    size_t n;
+    while ((n = fread(buf, 1, sizeof(buf), in)) > 0) {
+        if (fwrite(buf, 1, n, out) != n) { ec = std::make_error_code(std::errc::io_error); fprintf(stderr, "[save] write to %s failed\n", to.string().c_str()); break; }
+    }
+    fclose(in);
+    if (fclose(out) != 0 && !ec) ec = std::make_error_code(std::errc::io_error);
+}
