+static inline void DMULT(int64_t a, int64_t b, int64_t* lo64, int64_t* hi64) {
+    uint64_t low, high;
+    DMULTU((uint64_t)a, (uint64_t)b, &low, &high);
+    if (a < 0) high -= (uint64_t)b;
+    if (b < 0) high -= (uint64_t)a;
+    *lo64 = (int64_t)low;
