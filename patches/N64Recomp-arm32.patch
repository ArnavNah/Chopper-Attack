+// Multiply four 32-bit limbs on hosts without a native 128-bit integer.
+static inline void DMULTU(uint64_t a, uint64_t b, uint64_t* lo64, uint64_t* hi64) {
+    const uint64_t low = (uint64_t)(uint32_t)a * (uint32_t)b;
+    const uint64_t cross1 = (a >> 32) * (uint32_t)b;
+    const uint64_t cross2 = (uint64_t)(uint32_t)a * (b >> 32);
+    const uint64_t middle = (low >> 32) + (uint32_t)cross1 + (uint32_t)cross2;
+    *lo64 = (middle << 32) | (uint32_t)low;
+    *hi64 = (a >> 32) * (b >> 32) + (cross1 >> 32) + (cross2 >> 32) + (middle >> 32);
+}
