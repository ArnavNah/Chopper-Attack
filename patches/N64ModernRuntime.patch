 #include "ultramodern/ultra64.h"
+#include <chrono>
+#include <cstdio>
+#include <cstdarg>
+#include <filesystem>
+#include <mutex>
+#include <cstdlib>
+
+static FILE* s_runtime_log_file = nullptr;
+static std::mutex s_runtime_log_mutex;
+static std::chrono::steady_clock::time_point s_log_start_time = std::chrono::steady_clock::now();
+
+extern "C" void runtime_log(const char* fmt, ...) {
+    static const bool enabled = std::getenv("CHOPPER_DEBUG") != nullptr;
+    if (!enabled) return;
+    std::lock_guard<std::mutex> lock(s_runtime_log_mutex);
+    if (!s_runtime_log_file) {
+        std::error_code ec;
+        std::filesystem::create_directories("evidence", ec);
+        s_runtime_log_file = fopen("evidence/runtime.log", "w");
+    }
+    auto now = std::chrono::steady_clock::now();
+    auto elapsed_ms = std::chrono::duration_cast<std::chrono::milliseconds>(now - s_log_start_time).count();
+
+    char buffer[1024];
+    va_list args;
+    va_start(args, fmt);
+    vsnprintf(buffer, sizeof(buffer), fmt, args);
+    va_end(args);
+
+    static int s_line_count = 0;
+    s_line_count++;
+
+    if (s_runtime_log_file) {
+        fprintf(s_runtime_log_file, "[%6lld ms] %s\n", (long long)elapsed_ms, buffer);
+        if ((s_line_count % 50 == 0) || strstr(buffer, "Task") || strstr(buffer, "osVi") || strstr(buffer, "Game Loop")) {
+            fflush(s_runtime_log_file);
+        }
+    }
+    // Only print milestones and thread lifecycle to console, not thousands of routine context switches
+    if (strstr(buffer, "Task") || strstr(buffer, "osCreateThread") || strstr(buffer, "osStartThread") || strstr(buffer, "osVi") || strstr(buffer, "Gfx") || strstr(buffer, "Scheduler") || (s_line_count <= 25)) {
+        printf("[%6lld ms] %s\n", (long long)elapsed_ms, buffer);
+    }
+}
 
