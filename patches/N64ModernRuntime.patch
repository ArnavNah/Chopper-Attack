+    runtime_log("================ THREAD STATE TABLE ================");
+    printf("\n========================================================================================\n");
+    printf("                               THREAD RUNTIME STATE TABLE                               \n");
+    printf("========================================================================================\n");
+    printf("%-4s %-6s %-10s %-16s %-12s %-12s %-12s\n",
+           "ID", "Pri", "State", "Blocked MQ", "Blocked Op", "Entry", "SP");
+    printf("----------------------------------------------------------------------------------------\n");
+
+    for (const auto& tt : s_tracked_threads) {
+        OSThread* t = TO_PTR(OSThread, tt.t_);
+        if (!t) continue;
+
+        const char* state_str = "UNKNOWN";
+        const char* op_str = "NONE";
+        uint32_t mq_addr = 0;
+
+        if (tt.t_ == ultramodern::this_thread() || ((int)t->id == s_global_active_thread_id.load() && t->queue == NULLPTR)) {
+            state_str = "RUNNING";
+        } else if (t->queue == ultramodern::running_queue) {
+            state_str = "READY";
+        } else if (t->queue == NULLPTR) {
+            if (t->state == OSThreadState::STOPPED) {
+                state_str = "STOPPED";
+            } else {
+                state_str = "IDLE";
+            }
+        } else {
+            state_str = "BLOCKED";
+            uint32_t q = (uint32_t)t->queue;
+            mq_addr = q;
+            op_str = "RECV";
+            if (q >= 0x80000000 && q < 0x807FFF00 && (q & 3) == 0 && s_rdram != nullptr) {
+                // In libultra OSMesgQueue:
+                // offset 0 is blocked_on_recv (t->queue == mq)
+                // offset 4 is blocked_on_send (t->queue == mq + 4)
+                uint32_t phys_recv = q & 0x007FFFFF;
+                if (phys_recv + sizeof(OSMesgQueue) <= 0x00800000) {
+                    OSMesgQueue* mq_recv = (OSMesgQueue*)(s_rdram + phys_recv);
+                    if (mq_recv->blocked_on_recv == tt.t_) {
+                        mq_addr = q;
+                        op_str = "RECV";
+                    }
+                }
+                if (q >= 0x80000004) {
+                    uint32_t phys_send = (q - 4) & 0x007FFFFF;
+                    if (phys_send + sizeof(OSMesgQueue) <= 0x00800000) {
+                        OSMesgQueue* mq_send = (OSMesgQueue*)(s_rdram + phys_send);
+                        if (mq_send->blocked_on_send == tt.t_) {
+                            mq_addr = q - 4;
+                            op_str = "SEND";
+                        }
+                    }
+                }
+            }
+        }
+
+        char mq_buf[32] = "None";
+        if (mq_addr != 0) {
+            snprintf(mq_buf, sizeof(mq_buf), "0x%08X", mq_addr);
+        }
+
+        printf("%-4d %-6d %-10s %-16s %-12s 0x%08X   0x%08X\n",
