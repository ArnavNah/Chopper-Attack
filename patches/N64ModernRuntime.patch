 extern "C" void osAiSetNextBuffer_recomp(uint8_t* rdram, recomp_context* ctx) {
+    runtime_log("[osAiSetNextBuffer] thread=%d, buf=0x%08X, size=%u", ultramodern_get_thread_id(), (uint32_t)ctx->r4, (uint32_t)ctx->r5);
     ultramodern::queue_audio_buffer(rdram, ctx->r4, ctx->r5);
     ctx->r2 = 0;
 }
 
 extern "C" void osAiGetLength_recomp(uint8_t* rdram, recomp_context* ctx) {
-    ctx->r2 = ultramodern::get_remaining_audio_bytes();
+    // The game computes its next buffer from this value and a per-frame target.
+    // The host queue can contain several buffers; an N64 AI length represents
+    // only the active DMA. Keep the reported value within the game's target.
+    uint32_t target_frames = *reinterpret_cast<uint32_t*>(rdram + 0xDBDEC);
+    uint32_t limit = target_frames <= 4096 ? target_frames * 4 : 0;
+    ctx->r2 = std::min(ultramodern::get_remaining_audio_bytes(), limit) & ~7u;
+    runtime_log("[osAiGetLength] thread=%d -> %u", ultramodern_get_thread_id(), (uint32_t)ctx->r2);
 }
 
 extern "C" void osAiGetStatus_recomp(uint8_t* rdram, recomp_context* ctx) {
     ctx->r2 = 0x00000000; // Pretend the audio DMAs finish instantly
+    runtime_log("[osAiGetStatus] thread=%d -> 0x%08X", ultramodern_get_thread_id(), (uint32_t)ctx->r2);
 }
